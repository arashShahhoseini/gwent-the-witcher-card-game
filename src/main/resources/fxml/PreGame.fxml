<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PreGameMenuController"
      stylesheets="@../CSS/style.css" styleClass="paneId">
    <Label layoutX="255.0" layoutY="10.0" text="Gwent">
        <font>
            <Font size="25.0"/>
        </font>
    </Label>
    <TextField fx:id="userName" alignment="CENTER" layoutX="190.0" layoutY="124.0" prefHeight="25.0" prefWidth="167.0"
               promptText="Start Game With:" onKeyPressed="#handleTextField"/>
    <Button layoutX="360.0" layoutY="124.0" mnemonicParsing="false" onMouseClicked="#applyOpponent" prefHeight="25.0"
            prefWidth="50.0" text="apply" styleClass="applyButton"/>
    <Button layoutX="190.0" layoutY="156.0" prefHeight="25.0" prefWidth="217.0" onMouseClicked="#startGame"
            text="start game"/>
    <Button layoutX="190.0" layoutY="188.0" prefHeight="25.0" prefWidth="217.0" onMouseClicked="#selectTerritory"
            text="select territory"/>
    <Button layoutX="190.0" layoutY="220.0" prefHeight="25.0" prefWidth="217.0" onMouseClicked="#selectLeader"
            text="select leader"/>
    <Button layoutX="190.0" layoutY="252.0" prefHeight="25.0" prefWidth="217.0" onMouseClicked="#selectCard"
            text="select cards"/>
    <Button layoutX="190.0" layoutY="284.0" prefHeight="25.0" prefWidth="217.0" onMouseClicked="#showDeck" text="deck"/>
    <Button layoutX="240.0" layoutY="316.0" mnemonicParsing="false" onMouseClicked="#exit" prefHeight="25.0"
            prefWidth="118.0" text="exit" styleClass="exitButton"/>
</Pane>