<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
             xmlns:fx="http://javafx.com/fxml"
             fx:controller="controller.RankController">
<center>
    <VBox spacing="20" alignment="CENTER" stylesheets="@../CSS/style.css">
        <Label text="Leader Board" maxWidth="300" styleClass="header" alignment="CENTER"/>
        <HBox alignment="CENTER" spacing="10">
            <VBox alignment="CENTER" spacing="5">
                <Button fx:id="first" maxWidth="200" minWidth="300"/>
                <Button fx:id="second" maxWidth="300"/>
                <Button fx:id="third" maxWidth="300"/>
                <Button fx:id="forth" maxWidth="300"/>
                <Button fx:id="fifth" maxWidth="300"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Button fx:id="sixth" maxWidth="300" minWidth="300"/>
                <Button fx:id="seventh" maxWidth="300"/>
                <Button fx:id="eighth" maxWidth="300"/>
                <Button fx:id="ninth" maxWidth="300"/>
                <Button fx:id="tenth" maxWidth="300"/>
            </VBox>
        </HBox>
        <Button text="back" onMouseClicked="#back" maxWidth="300"/>
    </VBox>
</center>
</BorderPane>